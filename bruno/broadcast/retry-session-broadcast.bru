meta {
  name: retry-session-broadcast
  type: http
  seq: 6
}

get {
  url: {{url}}/sessions/o1w0awic9mnsvyzfcsqex4qb/trigger?include_failed=true
  body: json
  auth: none
}

params:query {
  include_failed: true
}

headers {
  ~app-id: {{app-id}}
}

tests {
  var data = res.getBody().data;
  
  if(data){
    bru.setEnvVar("broadcast-id", data[0].cuid);
    bru.setEnvVar("xref-id",data[0].xref)
  }
}
