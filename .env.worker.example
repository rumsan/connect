# Per-worker env for a voice worker. Copy to .env.worker1 / .env.worker2 (both
# gitignored) and run them with:
#
#   pnpm start:asterisk-worker:w1
#   pnpm start:asterisk-worker:w2
#
# These scripts source the file before starting nx, so anything set here takes
# precedence over the root .env. Keep the ASTERISK_* block out of the root .env
# entirely — otherwise it is ambiguous which box a worker is talking to.

# --- identity -----------------------------------------------------------------
# Unique. Drives the worker's private queue (rsconnect.transport.voice.<id>),
# its routing key, and its .data/<id>/ scratch directory.
WORKER_ID=voice-1

# 1 = primary. Sessions fill this worker first and only spill to priority 2
# when it cannot hold them all at once.
WORKER_PRIORITY=1

# Capacity: max concurrent calls this worker accepts. Match it to this box's
# ASTERISK_TRUNK_CHANNELS — over-sizing it just produces CONGESTION.
BATCH_SIZE=10

# Health endpoint port. Must differ per worker when sharing a host.
PORT=5653

WORKER_HEARTBEAT_MS=15000

# --- shared infrastructure ----------------------------------------------------
AMQP_URL=amqp://localhost:5672
RSCONNECT_API_URL=http://localhost:3000/api

# --- this worker's Asterisk box -----------------------------------------------
ASTERISK_HOST=10.0.0.11
ASTERISK_TRUNK=PJSIP/trunk-a
ASTERISK_CALLER_ID=9800000000
ASTERISK_TRUNK_CHANNELS=10
ASTERISK_TIMEOUT=30
ASTERISK_AUDIO_PATH=/var/lib/asterisk/sounds/rsconnect

ASTERISK_ARI=http://10.0.0.11:8088
ASTERISK_ARI_USER=rsconnect
ASTERISK_ARI_PASS=change-me

ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=rsconnect
ASTERISK_AMI_PASS=change-me

ASTERISK_SSH_PORT=22
ASTERISK_SSH_USER=root
ASTERISK_SSH_PASS=change-me

# --- IVR voice responses ------------------------------------------------------
# Defaults for a dialplan `record` node; each field can be overridden per node.
IVR_RECORD_FORMAT=wav
IVR_RECORD_MAX_DURATION_SECONDS=60
IVR_RECORD_MAX_SILENCE_SECONDS=4
IVR_RECORD_TERMINATE_ON=#
IVR_RECORD_BEEP=true
# Ceiling on a node's maxDurationSeconds. Keep below CHANNEL_TTL_MS (180s) or
# the channel reaper will hang up on a caller who is still speaking.
IVR_RECORD_MAX_DURATION_CEILING_SECONDS=120
# Applies ONLY after a confirmed upload. A failed upload always keeps the file.
IVR_RECORD_DELETE_AFTER_UPLOAD=true
# Backstop: force-fail a stalled upload and send the report anyway.
IVR_RECORD_UPLOAD_TTL_MS=120000
IVR_RECORD_MAX_CONCURRENT_UPLOADS=4
# Only used to render the operator-facing `asteriskFile` path in the report.
ASTERISK_RECORDING_PATH=/var/spool/asterisk/recording

# --- object storage for voice responses (Cloudflare R2) -----------------------
# Leave unset to skip uploads entirely: recordings then stay on the Asterisk
# box and the report says so. Voice broadcasts are unaffected either way.
R2_ACCOUNT_ID=change-me
R2_BUCKET=rsconnect-voice-responses
# R2 > API > Manage API tokens, with "Object Read & Write" on this bucket.
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
# The bucket's public hostname, and REQUIRED for uploads to happen at all.
# R2 has no per-object ACLs, so this is the only way to know the public URL —
# and an upload nobody can read is worse than none, since the box copy is
# deleted on success. Set it from Cloudflare > R2 > your bucket > Settings >
# Public access: connect a custom domain, or enable the r2.dev subdomain.
R2_PUBLIC_BASE_URL=https://media.example.org
R2_RECORDING_PREFIX=voice-responses
