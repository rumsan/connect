# Per-worker env for a voice worker. Copy to .env.worker1 / .env.worker2 (both
# gitignored) and run them with:
#
#   pnpm start:asterisk-worker:w1
#   pnpm start:asterisk-worker:w2
#
# These scripts source the file before starting nx, so anything set here takes
# precedence over the root .env. Keep the ASTERISK_* block out of the root .env
# entirely — otherwise it is ambiguous which box a worker is talking to.

# --- identity -----------------------------------------------------------------
# Unique. Drives the worker's private queue (rsconnect.transport.voice.<id>),
# its routing key, and its .data/<id>/ scratch directory.
WORKER_ID=voice-1

# 1 = primary. Sessions fill this worker first and only spill to priority 2
# when it cannot hold them all at once.
WORKER_PRIORITY=1

# Capacity: max concurrent calls this worker accepts. Match it to this box's
# ASTERISK_TRUNK_CHANNELS — over-sizing it just produces CONGESTION.
BATCH_SIZE=10

# Health endpoint port. Must differ per worker when sharing a host.
PORT=5653

WORKER_HEARTBEAT_MS=15000

# --- shared infrastructure ----------------------------------------------------
AMQP_URL=amqp://localhost:5672
RSCONNECT_API_URL=http://localhost:3000/api

# --- this worker's Asterisk box -----------------------------------------------
ASTERISK_HOST=10.0.0.11
ASTERISK_TRUNK=PJSIP/trunk-a
ASTERISK_CALLER_ID=9800000000
ASTERISK_TRUNK_CHANNELS=10
ASTERISK_TIMEOUT=30
ASTERISK_AUDIO_PATH=/var/lib/asterisk/sounds/rsconnect

ASTERISK_ARI=http://10.0.0.11:8088
ASTERISK_ARI_USER=rsconnect
ASTERISK_ARI_PASS=change-me

ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=rsconnect
ASTERISK_AMI_PASS=change-me

ASTERISK_SSH_PORT=22
ASTERISK_SSH_USER=root
ASTERISK_SSH_PASS=change-me
