# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/connect"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AMQP Configuration
AMQP_URL=amqp://localhost:5672

# Scheduling Configuration
# Scheduler type: 'bull' (default) or 'redis_zset'
# 'bull' uses Bull's built-in delay mechanism
# 'redis_zset' uses Redis sorted sets for more efficient scheduling
BROADCAST_SCHEDULER=bull

# Time window (in hours) for scheduling messages
# Messages scheduled beyond this window will be queued by ScheduledWindowWorker
# when they enter the window (default: 48 hours)
BROADCAST_SCHEDULE_WINDOW_HOURS=48

# Batch size for processing scheduled messages (default: 50)
BROADCAST_SCHEDULER_BATCH_SIZE=50

# Redis keys for ZSET scheduler (only used when BROADCAST_SCHEDULER=redis_zset)
BROADCAST_SCHEDULER_ZSET_KEY=connect:broadcast:schedule:zset
BROADCAST_SCHEDULER_PAYLOAD_KEY=connect:broadcast:schedule:payload
BROADCAST_SCHEDULER_PROCESSING_KEY=connect:broadcast:schedule:processing

# ----------------------------------------------------------------------------
# Multi-worker broadcast dispatch (connect side)
# See docs/multi-worker-voice.mdx
# ----------------------------------------------------------------------------

# How long a broadcast may stay claimed by a worker before the reclaim sweeper
# assumes that worker is gone and hands it back. Must stay well above the
# worker-side BATCH_TTL_MS (120s) so a live worker reports real failures first.
BROADCAST_CLAIM_TTL_MS=600000

# Minimum number of overflow addresses before another worker is woken. Raise it
# if you would rather not spin up a second Asterisk for a handful of calls.
BROADCAST_SPILLOVER_MIN=1

# Must match the workers' WORKER_HEARTBEAT_MS; a worker is dropped from the
# roster after 3 missed heartbeats.
WORKER_HEARTBEAT_MS=15000

# Application Configuration
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Transport worker identity (asterisk-worker only — one .env per worker)
# ----------------------------------------------------------------------------

# Unique per worker. Drives its private queue name, its routing key and its
# local scratch directory. Leave unset to run a single worker on the shared
# queue exactly as before.
# WORKER_ID=voice-ktm-1

# 1 = primary. Sessions fill the lowest priority first and only spill upward
# when the primary cannot hold them.
# WORKER_PRIORITY=1

# This worker's capacity: the most concurrent broadcasts it will accept.
# Size it from that box's ASTERISK_TRUNK_CHANNELS.
# BATCH_SIZE=20

# How often this worker announces itself to connect.
# WORKER_HEARTBEAT_MS=15000

# HTTP port for the worker's health endpoint (GET /api/health). Give each
# worker its own when several run on one host.
# PORT=5653
